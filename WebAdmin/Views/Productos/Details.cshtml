@model ElectronicsStoreWeb.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">
                    <i class="fas fa-info-circle me-2"></i>Detalles del Producto
                </h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID:</dt>
                    <dd class="col-sm-9"><strong>#@Model.Id</strong></dd>

                    <dt class="col-sm-3">Nombre:</dt>
                    <dd class="col-sm-9"><h5 class="mb-0">@Model.NombreArticulo</h5></dd>

                    <dt class="col-sm-3">Marca:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary fs-6">@Model.Marca</span>
                    </dd>

                    <dt class="col-sm-3">Precio:</dt>
                    <dd class="col-sm-9">
                        <h4 class="text-success mb-0">$@Model.Precio.ToString("N2")</h4>
                    </dd>

                    <dt class="col-sm-3">Stock Disponible:</dt>
                    <dd class="col-sm-9">
                        @if (Model.Cantidad > 10)
                        {
                            <span class="badge bg-success fs-6">@Model.Cantidad unidades</span>
                        }
                        else if (Model.Cantidad > 0)
                        {
                            <span class="badge bg-warning text-dark fs-6">@Model.Cantidad unidades</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Agotado</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Descripción:</dt>
                    <dd class="col-sm-9">
                        <div class="card bg-light">
                            <div class="card-body">
                                @(Model.Descripcion ?? "Sin descripción")
                            </div>
                        </div>
                    </dd>

                    <dt class="col-sm-3">Fecha de Registro:</dt>
                    <dd class="col-sm-9">
                        <i class="fas fa-calendar me-2"></i>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </dd>
                </dl>

                <div class="d-flex gap-2 mt-4">
                    <a href="/Productos/Edit/@Model.Id" class="btn btn-warning btn-lg">
                        <i class="fas fa-edit me-2"></i>Editar
                    </a>
                    <a href="/Productos" class="btn btn-secondary btn-lg">
                        <i class="fas fa-arrow-left me-2"></i>Volver
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
