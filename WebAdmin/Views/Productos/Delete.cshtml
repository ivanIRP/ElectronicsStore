@model ElectronicsStoreWeb.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    <strong>¿Está seguro que desea eliminar este producto?</strong>
                    <p class="mb-0 mt-2">Esta acción no se puede deshacer.</p>
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Nombre:</dt>
                    <dd class="col-sm-9">@Model.NombreArticulo</dd>

                    <dt class="col-sm-3">Marca:</dt>
                    <dd class="col-sm-9">@Model.Marca</dd>

                    <dt class="col-sm-3">Precio:</dt>
                    <dd class="col-sm-9 text-success fw-bold">$@Model.Precio.ToString("N2")</dd>

                    <dt class="col-sm-3">Stock:</dt>
                    <dd class="col-sm-9">@Model.Cantidad unidades</dd>

                    <dt class="col-sm-3">Descripción:</dt>
                    <dd class="col-sm-9">@(Model.Descripcion ?? "Sin descripción")</dd>

                    <dt class="col-sm-3">Fecha Registro:</dt>
                    <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>

                <form asp-action="Delete" method="post" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger btn-lg">
                            <i class="fas fa-trash me-2"></i>Sí, Eliminar
                        </button>
                        <a href="/Productos" class="btn btn-secondary btn-lg">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
