@{
    ViewData["Title"] = "Panel de Administración";
    var reporte = ViewBag.Reporte;
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-4">
            <i class="fas fa-chart-line me-2" style="color: var(--primary-color);"></i>Dashboard
        </h2>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #10b981, #059669);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 mb-2">Total Ventas</h6>
                        <h3 class="mb-0 fw-bold">$@(reporte?.totalVentas?.ToString("N2") ?? "0.00")</h3>
                    </div>
                    <i class="fas fa-dollar-sign fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #2563eb, #1e40af);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 mb-2">Productos Vendidos</h6>
                        <h3 class="mb-0 fw-bold">@(reporte?.totalProductosVendidos ?? 0)</h3>
                    </div>
                    <i class="fas fa-shopping-cart fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 mb-2">Total Productos</h6>
                        <h3 class="mb-0 fw-bold">@ViewBag.TotalProductos</h3>
                    </div>
                    <i class="fas fa-box fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-white" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 mb-2">Bajo Stock</h6>
                        <h3 class="mb-0 fw-bold">@ViewBag.ProductosBajoStock</h3>
                    </div>
                    <i class="fas fa-exclamation-triangle fa-3x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title fw-bold mb-4">
                    <i class="fas fa-info-circle me-2" style="color: var(--primary-color);"></i>Acciones Rápidas
                </h5>
                <div class="d-grid gap-3">
                    <a href="/Productos/Create" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus-circle me-2"></i>Agregar Nuevo Producto
                    </a>
                    <a href="/Productos" class="btn btn-outline-primary btn-lg">
                        <i class="fas fa-list me-2"></i>Ver Todos los Productos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title fw-bold mb-4">
                    <i class="fas fa-chart-bar me-2" style="color: var(--primary-color);"></i>Estadísticas
                </h5>
                <div class="mb-3">
                    <small class="text-muted">Número de Compras</small>
                    <h4 class="fw-bold">@(reporte?.numeroCompras ?? 0)</h4>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Promedio por Venta</small>
                    <h4 class="fw-bold">$@(reporte?.promedioVenta?.ToString("N2") ?? "0.00")</h4>
                </div>
            </div>
        </div>
    </div>
</div>
